# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dcc
# or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dcc

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=Dcchelp1@gmail.com
EMAIL_PASS=your-app-password-here

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password (not your regular password)
# 3. Use the App Password as EMAIL_PASS

# Razorpay Configuration (if using payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google OAuth Configuration (for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Scheduled maintenance (CRM file cleanup). Call GET /api/cron/maintenance with:
# Authorization: Bearer <CRON_SECRET>  OR  ?secret=<CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# Environment
NODE_ENV=development

# Public site URL (production) — sitemap, robots, canonical URLs, OG tags
NEXT_PUBLIC_SITE_URL=https://www.digitalcareercenter.com

# File uploads (WHM/cPanel production)
# UPLOAD_DIR=/home/youruser/dcc_webiste_crm/public/uploads
# PUBLIC_DIR=/home/youruser/dcc_webiste_crm/public
# UPLOAD_MAX_MB=512
# UPLOAD_FALLBACK_DATA_URL=1
