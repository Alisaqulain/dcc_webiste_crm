# Secure Video Configuration
# Copy these to your .env.local file

# ============================================
# Cloudflare Stream (Recommended)
# ============================================
# Get these from: https://dash.cloudflare.com/
# 1. Go to Stream
# 2. Get Account ID from URL or dashboard
# 3. Create API Token with Stream:Edit permissions
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# ============================================
# Vimeo Pro (Alternative)
# ============================================
# Get this from: https://developer.vimeo.com/apps
# 1. Create a new app
# 2. Generate Access Token with video:read scope
VIMEO_ACCESS_TOKEN=your_vimeo_access_token_here

# ============================================
# AWS S3 + CloudFront (Self-hosted)
# ============================================
# Get these from AWS Console:
# 1. S3: Create bucket and upload videos
# 2. CloudFront: Create distribution
# 3. CloudFront: Create key pair for signed URLs
# 4. Download private key file

# CloudFront Distribution Domain
CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net

# CloudFront Key Pair ID (from AWS Console)
CLOUDFRONT_KEY_PAIR_ID=your_key_pair_id_here

# CloudFront Private Key
# Option 1: Path to private key file (recommended for production)
CLOUDFRONT_PRIVATE_KEY=/path/to/cloudfront-private-key.pem

# Option 2: Private key content (base64 or PEM format)
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ============================================
# Notes
# ============================================
# - Only configure ONE provider (or support multiple)
# - Cloudflare Stream is recommended for best security
# - Vimeo Pro is good for domain restrictions
# - AWS S3+CloudFront gives full control
# - Remove unused provider configurations

